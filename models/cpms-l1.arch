connector A-K79 nature dependency coupling blocking
    carries "Unidades listas y solicitud de vagones (SoS_K24a)" : T3.12 -> CGW
connector A-K80 nature data_flow coupling supply
    carries "Confirmación de convoy y ventana de cargue (SoS_K24b)" : CGW -> T3.12
connector A-K81 nature dependency coupling blocking
    carries "Aviso de convoy de exportación y solicitud de zona (SoS_K25a)" : CGW -> T3.12
connector A-K82 nature data_flow coupling supply
    carries "Zona, punto y ventana de descargue asignados (SoS_K25b)" : T3.12 -> CGW
connector A-K83 nature dependency coupling blocking
    carries "Solicitud de capacidad de camiones para retiro (SoS_K26a)" : T3.12 -> CGW
connector A-K84 nature data_flow coupling supply
    carries "Vehículos y cita de retiro confirmados, o rechazo (SoS_K26b)" : CGW -> T3.12
connector A-K85 nature event_notification coupling sink
    carries "Custodia recibida por el puerto (SoS_K29)" : T3.8 -> CGW
connector A-K86 nature dependency coupling blocking
    carries "Unidades listas y solicitud de capacidad fluvial (SoS_K31a)" : T3.12 -> CGW
connector A-K87 nature data_flow coupling supply
    carries "Barcazas, muelle y ventana confirmados, o rechazo (SoS_K31b)" : CGW -> T3.12
connector A-K88 nature event_notification coupling supply
    carries "Cambio de levante recibido (SoS_K32)" : CGW -> T3.9

// ---------------------------------------------------------------------------
// Global connectors in which the CPMS takes part (Delivery 1, 3.3 and 4.4).
// Availability of the link between constituents: L11 (99.95).
// ---------------------------------------------------------------------------

connector SoS_K1a nature dependency coupling blocking
    carries "Solicitud de cita portuaria y programación de camión y conductor"
    agreement "Contrato de citas portuarias (v1)" availability 99.95
    : RGW -> CGW
connector SoS_K1b nature data_flow coupling blocking
    carries "Confirmación de cita, ventana horaria y carril, o rechazo"
    agreement "Contrato de citas portuarias (v1)" availability 99.95
    : CGW -> RGW
connector SoS_K10a nature dependency coupling blocking
    carries "Arribo de barcaza y solicitud de muelle de transferencia"
    agreement "Contrato de transferencia puerto-barcaza (v1, v2)" availability 99.95
    : FGW -> CGW
connector SoS_K10b nature data_flow coupling blocking
    carries "Asignación de muelle de transferencia y ventana, o rechazo"
    agreement "Contrato de transferencia puerto-barcaza (v1, v2)" availability 99.95
    : CGW -> FGW
connector SoS_K11 nature event_notification coupling sink
    carries "Arribo/zarpe de motonave y manifiesto en puertos del Caribe"
    agreement "Aviso de arribo y manifiesto (v1)" availability 99.95
    : CGW -> NCG
connector SoS_K12a nature dependency coupling blocking
    carries "Solicitud de validación de levante previa a la salida por portería"
    agreement "Contrato de levante aduanero (v1)" availability 99.95
    : CGW -> NCG
connector SoS_K12b nature data_flow coupling blocking
    carries "Estado de levante: concedido, inspección requerida o retenido"
    agreement "Contrato de levante aduanero (v1)" availability 99.95
    : NCG -> CGW
// P7: maximum 2 queries/s during degradation; 1.5 queries/s scheduled (L22).
connector SoS_K21a nature dependency coupling blocking
    carries "Consulta de estado consolidado de la carga en la que participa el operador portuario"
    agreement "Contrato de estado consolidado; regla de acceso y tasa P7"
    availability 99.95 event_capacity 2 event_load 1.5
    : CGW -> NCG
connector SoS_K21b nature data_flow coupling blocking
    carries "Estado consolidado limitado a su carga; v3: posición y ETA estimadas"
    agreement "Contrato de estado consolidado; regla de acceso y tasa P7" availability 99.95
    : NCG -> CGW
connector SoS_K24a nature dependency coupling blocking
    carries "Unidades listas para transferencia patio-tren y solicitud de vagones"
    agreement "Contrato de transferencia puerto-tren (v1)" availability 99.95
    : CGW -> LGW
connector SoS_K24b nature data_flow coupling blocking
    carries "Confirmación de convoy, capacidad, plataforma y ventana, o rechazo"
    agreement "Contrato de transferencia puerto-tren (v1)" availability 99.95
    : LGW -> CGW
connector SoS_K25a nature dependency coupling blocking
    carries "Aviso de convoy de exportación y solicitud de zona y ventana de descargue"
    agreement "Contrato de transferencia puerto-tren (v1)" availability 99.95
    : LGW -> CGW
connector SoS_K25b nature data_flow coupling blocking
    carries "Zona de patio, punto y ventana de descargue, o rechazo"
    agreement "Contrato de transferencia puerto-tren (v1)" availability 99.95
    : CGW -> LGW
connector SoS_K26a nature dependency coupling blocking
    carries "Solicitud de camiones para retirar unidades liberadas en el Caribe"
    agreement "Contrato de retiro por camión (v1)" availability 99.95
    : CGW -> RGW
connector SoS_K26b nature data_flow coupling blocking
    carries "Vehículos asignados y cita de retiro, o rechazo"
    agreement "Contrato de retiro por camión (v1)" availability 99.95
    : RGW -> CGW
connector SoS_K29 nature event_notification coupling sink
    carries "Custodia recibida por el puerto del Caribe"
    agreement "Semántica de custodia; clave transferId (P8)" availability 99.95
    : CGW -> NCG
connector SoS_K31a nature dependency coupling blocking
    carries "Unidades liberadas para transferencia patio-barcaza y solicitud de capacidad"
    agreement "Contrato de transferencia puerto-barcaza (v1, v2)" availability 99.95
    : CGW -> FGW
connector SoS_K31b nature data_flow coupling blocking
    carries "Barcazas asignadas, muelle y ventana de cargue, o rechazo"
    agreement "Contrato de transferencia puerto-barcaza (v1, v2)" availability 99.95
    : FGW -> CGW
connector SoS_K32 nature event_notification coupling sink
    carries "Cambio de levante en puertos del Caribe; v3: estado de servicio"
    agreement "Aviso de levante y de estado de servicio (v2, P2)" availability 99.95 latency 10000
    : NCG -> CGW

// Context from sos.arch: stage 2 of SoS-QS1 (M4), between two neighbouring gateways.
connector SoS_K5 nature event_notification coupling sink
    carries "Custodia recibida por el transportador; v3: ETA al despachar"
    agreement "Semántica de custodia; clave transferId (P8)"
    latency 40000
    : RGW -> NCG

// ---------------------------------------------------------------------------
// Analyses (Delivery 2)
// ---------------------------------------------------------------------------

// A-QS2, chain C1 (exit through the gate), structure of Delivery 1: one instance of
// T3.6, T3.9 and T2.1; the exit waits for the link SoS_K12a (L11) and the NCS (L10).
// Delivery 2 gives no target; 99.9 is assumed.
analysis ExitAvailability scenario "A-QS2" availability target 99.9 :
    T3.6, T3.9, CGW, SoS_K12a, NCG

// Same chain with the pairs that Delivery 2 (4.4, A-QS2 "before") already assumes:
// T3.6, T3.9 and T2.1 as redundant pairs with beta = 5 % (L16). Reproduces the 99.84 %
// stated there (Delivery 1 has a single instance, see VALIDACION.md).
analysis ExitAvailabilityD2Before scenario "A-QS2 (D2 before)" availability target 99.9 :
    T3.6 replicas 2 beta 0.05, T3.9 replicas 2 beta 0.05, CGW replicas 2 beta 0.05,
    SoS_K12a, NCG

// A-QS4: field events doubled (L2 x L8 = 20 events/s) on T2.5, which absorbs
// 10 events/s per instance and does not scale horizontally (1 instance).
analysis FieldEventLoad scenario "A-QS4" utilization target 100 :
    T2.5

// A-QS6: scheduled queries to the NCS, 90 trucks every P = 60 s (L21, L22)
// against the maximum rate of the agreement (P7).
analysis ConsolidatedStateQueries scenario "A-QS6" utilization target 100 :
    SoS_K21a

// A-QS4, response measure of Delivery 2: reading -> T3.6 <= 200 ms (p99) at 20 events/s.
// Path T5.6 -> T2.5 -> T2.2 -> T3.6 (A-K1, A-K5, A-K22), 50 ms p99 per internal hop (L14).
// The sum only holds if T2.5 is not saturated: see FieldEventLoad (utilization).
analysis FieldEventLatency scenario "A-QS4 (latency)" latency target 200 :
    A-K1, A-K5, A-K22

// A-QS6, response measure of Delivery 2: the port reconciles the 120 affected appointments
// (L23) in <= 300 s after "restablecido". At 2 queries/s (P7): 60 s; 120 s if every query
// needs its single retry (L24). Metric deadline (as in the models of team D): budgets in seconds.
analysis PortReconciliation scenario "A-QS6 (reconciliation)" deadline target 300 :
    CGW = 60
analysis PortReconciliationRetry scenario "A-QS6 (reconciliation, one retry per query)" deadline target 300 :
    CGW = 120

// SoS-QS1, measure M4 (Delivery 2, 3.6.6), same analysis as sos.arch; budgets in ms.
//   RGW 200 s recovers and re-sends; SoS_K5 40 s; NCG 230 s consolidates;
//   SoS_K32 10 s "restablecido" notice; CGW 300 s reconciliation (Delivery 2: 780 s <= 900 s).
analysis SoSQS1M4 scenario "SoS-QS1 (M4)" latency target 900000 :
    RGW, SoS_K5, NCG, SoS_K32, CGW
