// Model (M1) of the CPMS: structure of Delivery 1, properties of Delivery 2
//
// Sources: Delivery 1 (components 4.2, internal connectors A-K1..A-K88 in 4.3,
// global connectors in 3.3 and 4.4) and Delivery 2 (coupling 4.1, load
// assumptions L1..L24 in 4.3).
//
// Conventions:
//  - Internal components keep the identifier of Delivery 1 (T1.1 .. T5.10).
//  - The boundary components are written with the names they will have in
//    sos.arch (CGW is T2.1; the others are the gateways of the neighbours).
//  - Connectors keep their identifiers: A-K1..A-K88 and SoS-K..., with the
//    request/response pairs "a"/"b".
//  - Rates are per second; availability in %. Values marked (illustrative)
//    are those of Delivery 2.

system CPMS

constituent CPS "Sistema de Gestión de Puertos del Caribe" owner "Operadores portuarios de la costa Caribe"
constituent RTS "Sistema de Transporte Carretero" owner "Empresas transportadoras y operadores de flotas"
constituent RLS "Sistema de Transporte Férreo" owner "Concesionarios férreos"
constituent FTS "Sistema de Transporte Fluvial" owner "Operadores de navegación fluvial"
constituent NCS "Sistema de Coordinación Nacional" owner "Autoridad nacional (transporte, aduanas y control)"

// T1 — Presentación
component T1.1 "T1.1 Panel de control operativo"            in CPS tier T1 kind software
component T1.2 "T1.2 Consola de planificación"              in CPS tier T1 kind software
component T1.3 "T1.3 Portal de agentes y transportistas"    in CPS tier T1 kind software
component T1.4 "T1.4 Terminal de cabina de equipos"         in CPS tier T1 kind hardware_software
component T1.5 "T1.5 Kiosco de portería"                    in CPS tier T1 kind hardware_software
component T1.6 "T1.6 Consola de inspección"                 in CPS tier T1 kind software

// T2 — Comunicación (L9: 99.95; L10: T2.5 99.9). T2.5 absorbs 10 events/s per
// instance (L2); the load is L2 x L8 (growth x2) = 20 events/s.
component CGW "Caribbean Port Gateway"                   in CPS tier T2 kind software availability 99.95 latency 300000
component T2.2 "T2.2 Broker de eventos interno"              in CPS tier T2 kind software availability 99.95
component T2.3 "T2.3 Adaptador de navieras y agentes"        in CPS tier T2 kind software availability 99.95
component T2.4 "T2.4 Adaptador de equipos del terminal"      in CPS tier T2 kind hardware_software availability 99.95
component T2.5 "T2.5 Gateway IoT de campo"                   in CPS tier T2 kind hardware availability 99.90 event_capacity 10 event_load 20
component T2.6 "T2.6 Receptor AIS de buques"                 in CPS tier T2 kind hardware availability 99.95
component T2.7 "T2.7 Backend para clientes externos (BFF)"   in CPS tier T2 kind software availability 99.95

// T3 — Lógica (L9: 99.95)
component T3.1  "T3.1 Gestión de escalas"                    in CPS tier T3 kind software availability 99.95
component T3.2  "T3.2 Asignación de atraque"                 in CPS tier T3 kind software availability 99.95
component T3.3  "T3.3 Planificación de grúas de muelle"      in CPS tier T3 kind software availability 99.95
component T3.4  "T3.4 Gestión de patio"                      in CPS tier T3 kind software availability 99.95
component T3.5  "T3.5 Despacho de transporte interno"        in CPS tier T3 kind software availability 99.95
component T3.6  "T3.6 Gestión de portería y citas"           in CPS tier T3 kind software availability 99.95
component T3.7  "T3.7 Gestión de unidades de carga"          in CPS tier T3 kind software availability 99.95
component T3.8  "T3.8 Custodia y transferencia"              in CPS tier T3 kind software availability 99.95
component T3.9  "T3.9 Estado aduanero y retenciones"         in CPS tier T3 kind software availability 99.95
component T3.10 "T3.10 Coordinador de operaciones del terminal" in CPS tier T3 kind software availability 99.95
component T3.11 "T3.11 Seguridad y control de acceso"        in CPS tier T3 kind software availability 99.95
component T3.12 "T3.12 Planificación intermodal"             in CPS tier T3 kind software availability 99.95

// T4 — Datos
component T4.1 "T4.1 BD de unidades de carga"                in CPS tier T4 kind software
component T4.2 "T4.2 BD de escalas y atraques"               in CPS tier T4 kind software
component T4.3 "T4.3 BD de citas"                            in CPS tier T4 kind software
component T4.4 "T4.4 Registro de custodia"                   in CPS tier T4 kind software
component T4.5 "T4.5 Repositorio documental"                 in CPS tier T4 kind software
component T4.6 "T4.6 BD de ocupación de patio"               in CPS tier T4 kind software
component T4.7 "T4.7 BD de retenciones"                      in CPS tier T4 kind software
component T4.8 "T4.8 Histórico de eventos"                   in CPS tier T4 kind software
component T4.9 "T4.9 BD de permisos de acceso"               in CPS tier T4 kind software

// T5 — Físico (L10: 99.9)
component T5.1  "T5.1 Grúas de muelle"                       in CPS tier T5 kind physical availability 99.90
component T5.2  "T5.2 Grúas de patio"                        in CPS tier T5 kind physical availability 99.90
component T5.3  "T5.3 Vehículos de transporte interno"       in CPS tier T5 kind physical availability 99.90
component T5.4  "T5.4 Carriles y barreras de portería"       in CPS tier T5 kind physical availability 99.90
component T5.5  "T5.5 Básculas de camiones"                  in CPS tier T5 kind physical availability 99.90
component T5.6  "T5.6 Lectores OCR/RFID"                     in CPS tier T5 kind hardware availability 99.90
component T5.7  "T5.7 Sensores de patio y refrigerados"      in CPS tier T5 kind hardware availability 99.90
component T5.8  "T5.8 Computadores a bordo de grúas"         in CPS tier T5 kind hardware availability 99.90
component T5.9  "T5.9 Cámaras de seguridad perimetral"       in CPS tier T5 kind hardware availability 99.90
component T5.10 "T5.10 Computadores a bordo de vehículos"    in CPS tier T5 kind hardware availability 99.90

// Boundary components of the neighbouring constituents (as in sos.arch)
component RGW  "Road Gateway"                  in RTS tier T2 kind software latency 200000
component LGW  "Rail Gateway"                  in RLS tier T2 kind software
component FGW  "Fluvial Gateway"               in FTS tier T2 kind software
component NCG   "National Coordination Gateway" in NCS  tier T2 kind software availability 99.90 latency 230000

// ---------------------------------------------------------------------------
// Internal connectors A-K1 .. A-K88 (Delivery 1, 4.3; coupling: Delivery 2, 4.1)
// ---------------------------------------------------------------------------

// Datos de campo hacia el sistema
connector A-K1 nature data_flow coupling supply
    carries "Placa, código de contenedor o precinto recién leídos" latency 50 : T5.6 -> T2.5
connector A-K2 nature data_flow coupling supply
    carries "Peso del camión y de la unidad" : T5.5 -> T2.5
connector A-K3 nature data_flow coupling supply
    carries "Temperatura y estado de unidades refrigeradas y del patio" : T5.7 -> T2.5
connector A-K4 nature data_flow coupling supply
    carries "Detecciones de las cámaras" : T5.9 -> T2.5
connector A-K5 nature event_notification coupling sink
    carries "Lecturas normalizadas y alarmas de campo" latency 50 : T2.5 -> T2.2
connector A-K6 nature data_flow coupling supply
    carries "Posición, estado y confirmación de movimientos de cada grúa" : T5.8 -> T2.4
connector A-K7 nature data_flow coupling supply
    carries "Posición, estado y confirmación de movimientos de cada vehículo" : T5.10 -> T2.4
connector A-K8 nature event_notification coupling sink
    carries "Avance de órdenes y estado de los equipos, en formato común" : T2.4 -> T2.2

// Control de equipos: jerarquía y lazo de control
connector A-K9 nature control_command coupling supply
    carries "Movimientos internos que deben despacharse" : T3.10 -> T3.5
connector A-K10 nature control_command coupling supply
    carries "Órdenes de trabajo para grúas" : T3.10 -> T2.4
connector A-K11 nature control_command coupling supply
    carries "Asignación de movimientos a vehículos internos" : T3.5 -> T2.4
connector A-K12 nature control_command coupling supply
    carries "Órdenes de grúa traducidas al lenguaje del equipo (autoridad: T3.10)" : T2.4 -> T5.8
connector A-K13 nature control_command coupling supply
    carries "Órdenes de vehículo traducidas al lenguaje del equipo (autoridad: T3.5)" : T2.4 -> T5.10
connector A-K14 nature control_command coupling supply
    carries "Accionamiento de izaje y traslación de la grúa de muelle; parada" : T5.8 -> T5.1
connector A-K15 nature data_flow coupling supply
    carries "Posición, carga y límites medidos en la grúa de muelle" : T5.1 -> T5.8
connector A-K16 nature control_command coupling supply
    carries "Accionamiento de izaje y traslación de la grúa de patio; parada" : T5.8 -> T5.2
connector A-K17 nature data_flow coupling supply
    carries "Posición, carga y límites medidos en la grúa de patio" : T5.2 -> T5.8
connector A-K18 nature control_command coupling supply
