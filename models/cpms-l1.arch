// Frontera: gateway <-> componentes internos (each one serves exactly one SoS-K)
connector A-K70 nature dependency coupling blocking
    carries "Solicitud de cita de camión recibida (SoS_K1a)" : CGW -> T3.6
connector A-K71 nature data_flow coupling supply
    carries "Confirmación o rechazo de la cita (SoS_K1b)" : T3.6 -> CGW
connector A-K72 nature dependency coupling blocking
    carries "Solicitud de muelle de transferencia para barcaza (SoS_K10a)" : CGW -> T3.2
connector A-K73 nature data_flow coupling supply
    carries "Muelle y ventana asignados a la barcaza (SoS_K10b)" : T3.2 -> CGW
connector A-K74 nature event_notification coupling sink
    carries "Arribo/zarpe de buque y manifiesto (SoS_K11)" : T3.1 -> CGW
connector A-K75 nature dependency coupling blocking
    carries "Solicitud de validación de levante (SoS_K12a)" : T3.9 -> CGW
connector A-K76 nature data_flow coupling supply
    carries "Estado de levante recibido (SoS_K12b)" : CGW -> T3.9
connector A-K77 nature dependency coupling blocking
    carries "Consulta de estado consolidado, verificación de la contraparte (SoS_K21a)" : T3.8 -> CGW
connector A-K78 nature data_flow coupling supply
