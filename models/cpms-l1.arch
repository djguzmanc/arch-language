connector A-K30 nature dependency coupling blocking
    carries "Solicitud de atraque para una escala" : T3.1 -> T3.2
connector A-K31 nature data_flow coupling supply
    carries "Muelle y ventana asignados" : T3.2 -> T3.1
connector A-K32 nature data_flow coupling supply
    carries "Ventana de atraque para planificar grúas" : T3.2 -> T3.3
connector A-K33 nature data_flow coupling supply
    carries "Plan de grúas y secuencia de carga y descarga" : T3.3 -> T3.10
connector A-K34 nature data_flow coupling supply
    carries "Plan de patio: posición destino de cada unidad" : T3.4 -> T3.10
connector A-K35 nature control_command coupling supply
    carries "Ajustes manuales del planificador al plan de atraque" : T1.2 -> T3.2
connector A-K36 nature control_command coupling supply
    carries "Ajustes manuales del planificador al plan de patio" : T1.2 -> T3.4
connector A-K37 nature data_flow coupling supply
    carries "Propuesta de atraque y ocupación de muelles, para revisión" : T3.2 -> T1.2
connector A-K38 nature data_flow coupling supply
    carries "Unidades declaradas en el manifiesto (alta de unidades)" : T3.1 -> T3.7

// Unidades, portería, aduana y custodia
connector A-K39 nature event_notification coupling supply
    carries "Entrada o salida de una unidad por portería" : T3.6 -> T3.7
connector A-K40 nature event_notification coupling supply
    carries "Unidad que requiere posición en patio" : T3.7 -> T3.4
connector A-K41 nature data_flow coupling supply
