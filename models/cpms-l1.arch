connector A-K42 nature dependency coupling blocking
    carries "Consulta del estado aduanero de una unidad en portería" : T3.6 -> T3.9
connector A-K43 nature data_flow coupling supply
    carries "Respuesta: unidad liberada o retenida" : T3.9 -> T3.6
connector A-K44 nature data_flow coupling supply
    carries "Ejecución y resultado de inspección física en puerto" : T1.6 -> T3.9
connector A-K45 nature event_notification coupling supply
    carries "Estado aduanero aplicado a la unidad" : T3.9 -> T3.7
connector A-K46 nature event_notification coupling supply
    carries "Entrega o recepción física en portería que genera cambio de custodia" : T3.6 -> T3.8
connector A-K47 nature data_flow coupling supply
    carries "Permisos de acceso vigentes" : T3.11 -> T3.6
connector A-K48 nature control_command coupling supply
    carries "Abrir o cerrar barrera" : T3.6 -> T2.5
connector A-K49 nature control_command coupling supply
    carries "Orden de apertura o cierre enviada a la barrera" : T2.5 -> T5.4
connector A-K50 nature event_notification coupling supply
    carries "Carga o descarga de tren, barcaza o buque completada" : T3.10 -> T3.8
connector A-K51 nature event_notification coupling supply
    carries "Unidades liberadas listas para evacuación intermodal" : T3.7 -> T3.12

// Portal y kiosco para clientes externos
connector A-K52 nature dependency coupling blocking
    carries "Solicitudes de cita y consultas" : T1.3 -> T2.7
connector A-K53 nature dependency coupling blocking
    carries "Petición de cita o consulta hacia portería" : T2.7 -> T3.6
connector A-K54 nature data_flow coupling supply
    carries "Resultado de la cita o consulta" : T3.6 -> T2.7
connector A-K55 nature data_flow coupling supply
    carries "Respuesta adaptada al portal" : T2.7 -> T1.3
connector A-K56 nature dependency coupling blocking
    carries "Registro de llegada del conductor" : T1.5 -> T2.7
connector A-K57 nature data_flow coupling supply
    carries "Instrucciones de carril y turno" : T2.7 -> T1.5

// Almacenes privados (un dueño por almacén)
connector A-K58 nature dependency coupling blocking
    carries "Estado, posición y documentos de las unidades" : T3.7 -> T4.1
connector A-K59 nature dependency coupling blocking
    carries "Escalas y plan de atraque vigente" : T3.1 -> T4.2
connector A-K60 nature dependency coupling blocking
    carries "Citas de portería" : T3.6 -> T4.3
connector A-K61 nature dependency coupling blocking
    carries "Registros de cambio de custodia" : T3.8 -> T4.4
connector A-K62 nature dependency coupling blocking
    carries "Manifiestos y documentos de la escala" : T3.1 -> T4.5
connector A-K63 nature dependency coupling blocking
    carries "Ocupación y reservas de patio" : T3.4 -> T4.6
connector A-K64 nature dependency coupling blocking
