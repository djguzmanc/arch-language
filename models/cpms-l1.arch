connector A-K23 nature event_notification coupling supply
    carries "Hechos de patio y de unidades refrigeradas" : T2.2 -> T3.4
connector A-K24 nature event_notification coupling supply
    carries "Avance de órdenes y estado de los equipos" : T2.2 -> T3.10
connector A-K25 nature event_notification coupling supply
    carries "Hechos de acceso y de seguridad perimetral" : T2.2 -> T3.11
connector A-K26 nature event_notification coupling sink
    carries "Todos los eventos operativos, para el histórico" : T2.2 -> T4.8
connector A-K27 nature event_notification coupling sink
    carries "Eventos en tiempo real para el panel" : T2.2 -> T1.1

// Escalas, atraque y planificación
